#!/usr/bin/env python3
"""Wireless Display launcher: big icon buttons, one per mode.

    wireless-display-gui          main launcher
    wireless-display-gui phone    "Connect a phone" chooser: prints usb|wifi|pair; exit 2 = cancelled, 3 = Back
"""
import os, subprocess, sys
from PyQt6.QtWidgets import QApplication, QWidget, QGridLayout, QToolButton, QLabel, QVBoxLayout, QHBoxLayout, QPushButton
from PyQt6.QtGui import QIcon
from PyQt6.QtCore import Qt, QSize

SCRIPT = os.path.expanduser("~/.local/bin/wireless-display")

# (mode, label, icon theme name, tooltip)
MODES = [
    ("cast",      "Cast to TV",        "video-television",          "Send this screen to a Miracast / Chromecast TV or projector"),
    ("airplay",   "AirPlay receiver",  "network-wireless",          "Receive the screen of an iPhone, iPad or Mac"),
    ("phone",     "Mirror phone",      "phone",                     "Mirror an Android / Samsung phone (scrcpy, USB or Wi-Fi)"),
    ("dex",       "DeX desktop",       "computer",                  "Samsung DeX-style desktop from the phone"),
    ("moonlight", "Other PC screen",   "input-gaming",              "Use another PC's screen via Moonlight / Sunshine"),
    ("hotspot",   "Wi-Fi hotspot",     "network-wireless-hotspot",  "Start / stop the hotspot, show the join QR code"),
]

# How the phone is reachable (used by `wireless-display phone|dex` when no device is attached)
PHONE_MODES = [
    ("usb",  "USB cable",        "drive-removable-media-usb", "Plug the phone in. USB debugging must be on in Developer options."),
    ("wifi", "Wi-Fi",            "network-wireless",          "Phone is on the hotspot or the same network (adb over TCP)."),
    ("pair", "Pair with code",   "dialog-password",           "Android 11+: Wireless debugging → Pair device with pairing code."),
]

class Win(QWidget):
    def __init__(self, modes=MODES, title_text="What do you want to do?", window_title="Wireless Display",
                 icon="video-display", on_pick=None, cols=3, on_back=None):
        super().__init__()
        self.on_pick = on_pick
        self.on_back = on_back
        self.setWindowTitle(window_title)
        self.setWindowIcon(QIcon.fromTheme(icon))
        lay = QVBoxLayout(self)
        title = QLabel(title_text)
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        title.setStyleSheet("font-size: 15px; font-weight: bold; margin: 4px;")
        lay.addWidget(title)
        grid = QGridLayout(); grid.setSpacing(10)
        lay.addLayout(grid)
        for i, (mode, label, icon, tip) in enumerate(modes):
            b = QToolButton()
            b.setText(label); b.setToolTip(tip)
            b.setIcon(QIcon.fromTheme(icon, QIcon.fromTheme("video-display")))
            b.setIconSize(QSize(64, 64))
            b.setToolButtonStyle(Qt.ToolButtonStyle.ToolButtonTextUnderIcon)
            b.setFixedSize(150, 120)
            b.setStyleSheet("QToolButton { font-size: 13px; border-radius: 10px; }")
            b.clicked.connect(lambda _=False, m=mode: self.launch(m))
            grid.addWidget(b, i // cols, i % cols)
        if on_back:
            row = QHBoxLayout(); row.addStretch()
            back = QPushButton(QIcon.fromTheme("go-previous"), "Back")
            back.setToolTip("Return to the Wireless Display menu")
            back.clicked.connect(self.go_back)
            row.addWidget(back); lay.addLayout(row)
        self.setFixedSize(self.sizeHint())

    def go_back(self):
        self.on_back()
        self.close()

    def launch(self, mode):
        if self.on_pick:
            self.on_pick(mode)
        else:
            subprocess.Popen([SCRIPT, mode], start_new_session=True,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.close()

if __name__ == "__main__":
    app = QApplication(sys.argv)
    if QIcon.fromTheme("computer").isNull():
        QIcon.setThemeSearchPaths(QIcon.themeSearchPaths() + ["/usr/share/icons", os.path.expanduser("~/.local/share/icons")])
        QIcon.setThemeName("breeze")
    if len(sys.argv) > 1 and sys.argv[1] == "phone":
        picked, back = [], []
        w = Win(PHONE_MODES, "No phone is connected yet. How is the phone reachable?",
                "Connect a phone", "phone", on_pick=picked.append, on_back=lambda: back.append(True))
        w.show(); app.exec()
        if picked:
            print(picked[0]); sys.exit(0)
        sys.exit(3 if back else 2)   # 3 = Back to main menu, 2 = cancelled (window closed)
    w = Win(); w.show()
    sys.exit(app.exec())
